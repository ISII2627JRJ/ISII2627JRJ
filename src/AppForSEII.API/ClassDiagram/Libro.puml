@startuml
class Libro {
    + Libro()
    + Libro(id:int, titulo:string, autor:string, fechaLanzamiento:DateTime, precioCompra:decimal, precioReposicion:decimal, stock:int, tipoLibro:string, calificacionMedia:double, genero:Genero, editorial:Editorial)
    + Id : int <<get>> <<set>>
    + Titulo : string <<get>> <<set>>
    + Autor : string <<get>> <<set>>
    + FechaLanzamiento : DateTime <<get>> <<set>>
    + PrecioCompra : decimal <<get>> <<set>>
    + PrecioReposicion : decimal <<get>> <<set>>
    + Stock : int <<get>> <<set>>
    + TipoLibro : string <<get>> <<set>>
    + CalificacionMedia : double <<get>> <<set>>
    + Genero : Genero <<get>> <<set>>
    + Editorial : Editorial <<get>> <<set>>
    + CompraItems : IList<CompraItem> <<get>> <<set>>
    + ReponeItems : IList<ReponeItem> <<get>> <<set>>
    + ResenaItems : IList<ResenaItem> <<get>> <<set>>
}
@enduml
